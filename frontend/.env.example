# Copy to `.env` and adjust. `.env` is not committed
# Real environment variables win over `.env`

# Backend that the dev server proxies `/api` to (see vite.config.ts)
BACKEND_URL=http://localhost:5137

# Dev server port
PORT=3000

# Variables read by the app code (`import.meta.env.VITE_*`) must start with `VITE_`.
# They end up in the built JS, so never put secrets in them
