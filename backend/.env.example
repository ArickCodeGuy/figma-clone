# Copy to `.env` and fill in. `.env` is not committed
# Real environment variables win over `.env`

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/figmaclone
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# JWT. HMAC512 signing key, any long random string
# e.g. `openssl rand -base64 64`
JWT_SECRET=
# Token life span in ms (10 hours)
JWT_LIFE_SPAN=36000000
